{
  "name": "atalay-terminal-staging",
  "version": "1.0.0",
  "private": true,
  "description": "Web staging for Atalay's Terminal (dashboard UI)",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "esbuild src/orbit/index.js --bundle --format=iife --target=es2020,safari16 --legal-comments=none --outfile=public/orbit.js",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
